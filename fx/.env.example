# Resend key used by /api/register to email new seat registrations to the team.
RESEND_API_KEY=
# Verified sender, e.g. "MAZAL FX <hello@joinmazal.org>". Falls back to Resend's sandbox sender.
RESEND_FROM=
# Inbox that receives registrations.
REGISTER_NOTIFY_EMAIL=gnclub.contactus@gmail.com
# Public site URL, used for metadata and the same-origin check on /api/register.
NEXT_PUBLIC_SITE_URL=http://localhost:3007
